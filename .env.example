# Zwift Control API Configuration
# Copy this file based on your deployment method:
#
# For LOCAL development (Mac/Linux):
#   cp .env.example .env.local
#   Edit .env.local and set SSH_KEY_PATH=~/.ssh/id_rsa
#   Run: ./run-local.sh
#
# For DOCKER deployment:
#   cp .env.example .env
#   Edit .env and configure SSH paths and container user
#   Run: ./run-docker.sh (or docker-compose up)

# PC Configuration (REQUIRED)
# Replace these placeholders with your actual PC details
PC_NAME=your-pc-hostname
PC_IP=192.168.1.XXX
PC_MAC=AA:BB:CC:DD:EE:FF
PC_USER=your-username

# API Configuration (Optional - defaults shown)
API_PORT=8000
LOG_LEVEL=INFO

# Timeout Configuration in seconds (Optional - defaults shown)
WOL_TIMEOUT=120
SSH_TIMEOUT=300
DESKTOP_TIMEOUT=60
ZWIFT_TIMEOUT=60

# Smart Plug Configuration (Optional)
# Shelly Gen2 plug carrying the PC's mains, auth disabled, driven over HTTP RPC.
# Leave ZWIFT_PLUG_IP empty to disable plug control entirely.
ZWIFT_PLUG_IP=
PLUG_SWITCH_TIMEOUT=30
# Delay after energising the plug before WoL, so the NIC is listening
PLUG_SETTLE_SECONDS=10
PLUG_POLL_INTERVAL=10
# Draw at or below this, held for PLUG_IDLE_SAMPLES readings, counts as off.
# Ping alone is not enough: Windows installs updates with the network down.
PLUG_IDLE_WATTS=10
PLUG_IDLE_SAMPLES=3
# Cap on waiting for a power-down. On expiry the mains are left ON.
SHUTDOWN_TIMEOUT=1800

# SSH Configuration
# For LOCAL development (.env.local):
#   SSH_KEY_PATH=~/.ssh/id_rsa
#
# For DOCKER deployment (.env):
#   SSH_KEY_PATH: Path inside container
#   SSH_KEY_HOST_PATH: ABSOLUTE path on host machine (will be mounted)
#   IMPORTANT: Use absolute path like /Users/yourname/.ssh/id_rsa
#                NOT ${HOME}/.ssh/id_rsa (doesn't expand correctly)
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_KEY_HOST_PATH=/Users/yourname/.ssh/id_rsa
SSH_CONNECT_TIMEOUT=10

# Docker Container Configuration (DOCKER deployment only)
# User UID/GID for running container (should match apiuser in Dockerfile)
CONTAINER_USER_UID=1000
CONTAINER_USER_GID=1000

# Process Configuration (Optional - defaults shown)
ZWIFT_SCHEDULED_TASK=LaunchZwiftRemote
SAUCE_SCHEDULED_TASK=LaunchSauceRemote
ZWIFT_LAUNCHER_KEYS_TASK=ZwiftLauncherKeys
